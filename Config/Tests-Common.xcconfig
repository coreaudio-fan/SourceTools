//	Architectures
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx

//	Deployment
MACOSX_DEPLOYMENT_TARGET = 26.0

//	Localization
STRING_CATALOG_GENERATE_SYMBOLS = NO
SWIFT_EMIT_LOC_STRINGS = NO

//	Packaging
GENERATE_INFOPLIST_FILE = YES
PRODUCT_BUNDLE_IDENTIFIER = coreaudio-fan.SourceTools.Tests
PRODUCT_NAME = SourceTools Tests

//	Documentation Compiler - Options
//	Documentation compilation is enforced on the Framework's published API; the test bundle publishes
//	none, so it opts out alongside the App and Extension targets.
RUN_DOCUMENTATION_COMPILER = NO
