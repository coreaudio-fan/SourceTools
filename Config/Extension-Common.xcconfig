//	Architectures
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx

//	Deployment
COMBINE_HIDPI_IMAGES = YES
MACOSX_DEPLOYMENT_TARGET = 26.0
SKIP_INSTALL = YES

//	Info.plist Values
INFOPLIST_KEY_CFBundleDisplayName = SourceTools for Xcode
INFOPLIST_KEY_NSHumanReadableCopyright = ©2026 by coreaudio-fan

//	Linking - General
//	The second runpath entry resolves from the appex binary up into the host app's
//	Contents/Frameworks, where SourceToolsCore.framework is embedded once. This is the value
//	Apple's own app-extension template ships.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks

//	Localization
STRING_CATALOG_GENERATE_SYMBOLS = YES
SWIFT_EMIT_LOC_STRINGS = YES

//	Packaging
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Extension-Info.plist
PRODUCT_BUNDLE_IDENTIFIER = coreaudio-fan.SourceTools.Extension
//	The space-bearing product name derives PRODUCT_MODULE_NAME as SourceTools_for_Xcode; the
//	class names in Config/Extension-Info.plist rely on that via $(PRODUCT_MODULE_NAME).
PRODUCT_NAME = SourceTools for Xcode

//	Search Paths
//	XcodeKit.framework lives in $(DEVELOPER_DIR)/Library/Frameworks, not in the macOS SDK. The
//	xcode-extension product type injects this path for the linker but not for the Swift compile,
//	so `import XcodeKit` needs it stated here.
FRAMEWORK_SEARCH_PATHS = $(inherited) $(DEVELOPER_FRAMEWORKS_DIR)

//	Signing
CODE_SIGN_ENTITLEMENTS = Config/Extension.entitlements
ENABLE_HARDENED_RUNTIME = YES
REGISTER_APP_GROUPS = YES
